{
  "name": "emr-component-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm build:controller && pnpm build:ui && pnpm build:storybook",
    "build:controller": "tsc -p packages/emr-controller/tsconfig.json",
    "check:node-controller": "node -e \"import('./packages/emr-controller/dist/index.js').then(module => { if (!module.StateController) process.exit(1) })\"",
    "check:ssr": "node tests/ssr-smoke.mjs",
    "build:ui": "ng build emr-ui",
    "storybook": "pnpm build:controller && ng run emr-ui:storybook",
    "build:storybook": "pnpm build:controller && ng run emr-ui:build-storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "check:architecture": "vitest run packages/emr-ui/src/lib/architecture.spec.ts",
    "check": "pnpm test && pnpm build:controller && pnpm check:node-controller && pnpm build:ui && pnpm check:ssr && pnpm check:react && pnpm check:stories",
    "check:react": "pnpm --filter @drguptavivek/emr-react typecheck && pnpm --filter @drguptavivek/emr-react typecheck:native",
    "check:stories": "tsc -p packages/emr-ui/tsconfig.storybook.json --noEmit --sourceMap"
  },
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/platform-server": "22.1.2",
    "@angular/router": "22.1.2",
    "@openng/optimus-ui": "2.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.2",
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.2",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/heroicons": "^35.0.1",
    "@playwright/test": "1.55.0",
    "@storybook/addon-a11y": "10.5.9",
    "@storybook/addon-docs": "10.5.9",
    "@storybook/angular": "10.5.9",
    "@types/node": "24.3.0",
    "axe-core": "4.10.3",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "ng-packagr": "22.1.1",
    "storybook": "10.5.9",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
